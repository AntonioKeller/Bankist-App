# ── Ogólne ──
PORT=3000
BAKERY_NAME=Cukiernia A.Keller
# Hasło do panelu (logowanie przeglądarkowe: dowolny login + to hasło). Zostaw puste tylko lokalnie!
APP_PASSWORD=
# Twój numer – dostaniesz SMS, gdy AI przekaże Ci trudną sprawę (opcjonalnie)
OWNER_PHONE=
TIME_ZONE=Europe/Warsaw

# ── AI (Claude) ── https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# true = proste odpowiedzi AI wysyła od razu na Messenger/Instagram; false = tylko szkic do akceptacji
AI_AUTO_REPLY=true
KNOWLEDGE_PATH=data/wiedza.md

# ── SMS ── console = tylko symulacja w logach; smsapi = prawdziwe SMS-y przez SMSAPI.pl
SMS_PROVIDER=console
SMSAPI_TOKEN=
# Nazwa nadawcy zarejestrowana w SMSAPI (np. AKeller). Puste = domyślny nadawca konta.
SMS_SENDER=
# Usuwa polskie znaki z SMS-ów (tańsze, dłuższe wiadomości)
SMS_NORMALIZE=true
PICKUP_REMINDER_HOURS=12

# ── Meta (Messenger + Instagram) ── https://developers.facebook.com
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# ── Inne źródła (formularz www, e-mail przez Make/Zapier) ──
INBOUND_API_KEY=
